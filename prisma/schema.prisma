generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Shop {
  id          String   @id @default(cuid())
  domain      String   @unique
  accessToken String
  scope       String
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  email       String?
  plan        Plan     @default(FREE)
  trialEndsAt DateTime?
  onboardedAt DateTime?
  uninstalledAt DateTime?
  googleRefreshToken String?
  googleCalendarId   String?
  googleSyncError    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locations    Location[]
  staff        StaffMember[]
  services     Service[]
  bookings     Booking[]
  templates    NotificationTemplate[]
  seats        TeamSeat[]
  insights     InsightsSnapshot[]
  waitlist     WaitlistEntry[]
  subscription Subscription?
  seatUsage SeatUsage[]

  @@index([domain])
  reservations Reservation[]
  webhookReceipts WebhookReceipt[]
  notificationTasks NotificationTask[]
  googleOAuthStates GoogleOAuthState[]
  additionalHours AdditionalHours[]
  accessLogs AccessLog[]
}

/** Audit trail of staff/team access to records containing customer personal data. */
model AccessLog {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  actor       String
  action      String
  recordCount Int
  createdAt   DateTime @default(now())

  @@index([shopId, createdAt])
}

enum Plan {
  FREE
  STANDARD
  PRO
  PRO_PLUS
}

model Subscription {
  shopifyShopGid String?
  currentPeriodStart DateTime?
  seatMeterActive Boolean @default(false)
  id               String    @id @default(cuid())
  shopId           String    @unique
  shop             Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan             Plan
  status           String
  shopifyChargeId  String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model TeamSeat {
  billingConsentAt DateTime?
  usage SeatUsage[]
  inviteTokenHash String? @unique
  inviteExpiresAt DateTime?
  sessionVersion Int @default(0)
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  email     String
  staffId   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  @@unique([shopId, email])
}

model Location {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name          String
  address       String?
  timezone      String
  posLocationId String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  services  Service[]
  bookings  Booking[]
  blackouts Blackout[]

  @@index([shopId])
  reservations Reservation[]
  additionalHours AdditionalHours[]
}

model StaffMember {
  id                 String   @id @default(cuid())
  shopId             String
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  firstName          String
  lastName           String
  email              String
  phone              String?
  contactLink        String?
  imageUrl           String?
  bio                String?
  timezone           String
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  locationIds  String[]
  services     ServiceStaff[]
  availability AvailabilityRule[]
  bookings     Booking[]
  blackouts    Blackout[]
  timeOff      TimeOffRequest[]

  @@index([shopId, active])
  reservations Reservation[]
  googleOAuthStates GoogleOAuthState[]
  additionalHours AdditionalHours[]
}

model TimeOffRequest {
  id        String      @id @default(cuid())
  shopId    String
  staffId   String
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  reason    String?
  status    String      @default("PENDING")
  createdAt DateTime    @default(now())
  @@index([shopId, status])
}

model Service {
  id             String      @id @default(cuid())
  shopId         String
  shop           Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  locationId     String
  location       Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  title          String
  slug           String
  description    String?
  durationMin    Int
  slotIntervalMin Int?
  customerCancelCutoffHours Int @default(0)
  customerRescheduleCutoffHours Int @default(0)
  bufferBefore   Int         @default(0)
  bufferAfter    Int         @default(0)
  capacity       Int         @default(1)
  isPrivate      Boolean     @default(true)
  priceCents     Int         @default(0)
  depositType    DepositType @default(NONE)
  depositValue   Int         @default(0)
  variantId      String?
  minNoticeHours Int         @default(1)
  maxAdvanceDays Int         @default(60)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  staff        ServiceStaff[]
  availability AvailabilityRule[]
  bookings     Booking[]
  questions    IntakeQuestion[]

  @@unique([shopId, slug])
  @@index([shopId, active])
  reservations Reservation[]
}

enum DepositType {
  NONE
  FIXED
  PERCENT
  FULL
}

model ServiceStaff {
  serviceId String
  staffId   String
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  @@id([serviceId, staffId])
}

model AvailabilityRule {
  id        String       @id @default(cuid())
  shopId    String
  staffId   String?
  staff     StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service?     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
  timezone  String
  createdAt DateTime     @default(now())

  @@index([shopId, staffId, weekday])
}


/** Explicit extra opening hours for one date; weekly rules remain in effect. */
model AdditionalHours {
  id         String @id @default(cuid())
  shopId     String
  shop       Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staffId    String?
  staff      StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startAt    DateTime
  endAt      DateTime
  timezone   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([shopId, locationId, startAt])
  @@index([shopId, staffId, startAt])
}

model Blackout {
  id         String       @id @default(cuid())
  shopId     String
  locationId String?
  location   Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staffId    String?
  staff      StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startAt    DateTime
  endAt      DateTime
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([shopId, startAt])
}

model Booking {
  id              String        @id @default(cuid())
  shopId          String
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  staffId         String
  staff           StaffMember   @relation(fields: [staffId], references: [id])
  locationId      String
  location        Location      @relation(fields: [locationId], references: [id])

  quantity        Int @default(1)
  idempotencyKey  String?
  reservationId  String? @unique
  reservation    Reservation? @relation(fields: [reservationId], references: [id])
  paidCents      Int @default(0)
  priceCents     Int @default(0)
  currency       String @default("USD")
  orderLineId    String?
  orderId         String?
  customerId      String?
  customerEmail   String
  customerName    String?
  customerPhone   String?

  startAt         DateTime
  endAt           DateTime
  status          BookingStatus @default(PENDING)

  notes           String?
  source          String        @default("widget")
  rescheduleToken String        @unique @default(uuid())
  cancelToken     String        @unique @default(uuid())
  googleEventId   String?
  googleEventCalendarId String?
  checkedInAt     DateTime?
  checkedInBy     String?
  contactLink     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers IntakeAnswer[]
  jobs    JobLog[]

  @@unique([shopId, idempotencyKey])
  @@unique([shopId, orderLineId])
  @@index([shopId, status, startAt])
  @@index([shopId, startAt])
  @@index([orderId])
  notificationTasks NotificationTask[]
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  NEEDS_REVIEW
}

model IntakeQuestion {
  id        String   @id @default(cuid())
  shopId    String
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  label     String
  type      String
  required  Boolean  @default(false)
  options   String[]
  sortOrder Int      @default(0)
  active Boolean @default(true)
}

model IntakeAnswer {
  id         String  @id @default(cuid())
  bookingId  String
  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  questionId String
  value      String
  @@index([bookingId])
}

model NotificationTemplate {
  id        String  @id @default(cuid())
  shopId    String
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type      String
  channel   String  @default("email")
  subject   String?
  body      String
  enabled   Boolean @default(true)
  offsetMin Int?
  @@unique([shopId, type, channel])
}

model JobLog {
  id        String   @id @default(cuid())
  dedupeKey String   @unique
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  type      String
  sentAt    DateTime @default(now())
  @@index([type, sentAt])
}

model InsightsSnapshot {
  id         String   @id @default(cuid())
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  forDate    DateTime
  highlights String[]
  nudge      String?
  model      String   @default("claude-haiku")
  createdAt  DateTime @default(now())
  @@unique([shopId, forDate])
}

model WaitlistEntry {
  id            String    @id @default(cuid())
  shopId        String
  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  serviceId     String
  staffId       String?
  customerEmail String
  desiredStart  DateTime
  desiredEnd    DateTime
  notifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  @@index([shopId, serviceId])
}

/** Shopify authentication sessions. Accessed only by the private SDK adapter. */
model Session {
  id            String   @id
  shop          String
  state         String
  isOnline      Boolean  @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  refreshToken  String?
  refreshTokenExpires DateTime?
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean  @default(false)
  locale        String?
  collaborator  Boolean? @default(false)
  emailVerified Boolean? @default(false)

  @@index([shop])
}

model Reservation {
  id             String   @id @default(uuid())
  shopId         String
  shop           Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service @relation(fields: [serviceId], references: [id])
  staffId        String
  staff          StaffMember @relation(fields: [staffId], references: [id])
  locationId     String
  location       Location @relation(fields: [locationId], references: [id])
  startAt        DateTime
  endAt          DateTime
  quantity       Int @default(1)
  expiresAt      DateTime
  idempotencyKey String
  priceCents     Int
  dueCents       Int @default(0)
  depositType    DepositType @default(NONE)
  answers        Json @default("[]")
  checkoutId     String?
  checkoutUrl    String?
  checkoutStartedAt DateTime?
  currency       String
  variantId      String?
  createdAt      DateTime @default(now())
  booking        Booking?
  @@unique([shopId, idempotencyKey])
  @@index([shopId, staffId, expiresAt])
}

model WebhookReceipt {
  id          String @id @default(uuid())
  shopId      String
  shop        Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  externalId  String
  topic       String
  payload     Json
  processedAt DateTime?
  attempts Int @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  @@unique([shopId, externalId])
  @@index([processedAt, createdAt])
}

model NotificationTask {
  id String @id @default(uuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bookingId String
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind String
  dedupeKey String @unique
  expectedStartAt DateTime
  runAt DateTime
  completedAt DateTime?
  attempts Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  @@index([completedAt, runAt])
}

model GoogleOAuthState {
  id String @id @default(uuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  staffId String?
  staff StaffMember? @relation(fields: [staffId], references: [id], onDelete: Cascade)
  nonceHash String
  verifier String
  expiresAt DateTime
  usedAt DateTime?
  @@index([expiresAt])
}

model SeatUsage {
  id String @id @default(uuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  seatId String
  seat TeamSeat @relation(fields: [seatId], references: [id], onDelete: Cascade)
  shopifyShopGid String
  periodStart DateTime
  periodEnd DateTime
  occurredAt DateTime
  submittedAt DateTime?
  attempts Int @default(0)
  lastError String?
  @@unique([shopId, seatId, periodStart])
  @@index([submittedAt, attempts])
}
