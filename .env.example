# ---- Shopify ----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.booknestapp.site
SCOPES=read_products,write_products,read_publications,write_publications,read_orders,write_orders,read_draft_orders,write_draft_orders,read_customers,write_customers,read_locations

# ---- Isolated PostgreSQL service in Coolify ----
DATABASE_URL=postgresql://user:pass@postgres-host:5432/booknest?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.neon.tech/booknest?sslmode=require

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="BookNest <bookings@yourdomain.com>"

# ---- Google Calendar ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.booknestapp.site/auth/google/callback

# ---- AI insights ----
ANTHROPIC_API_KEY=

# ---- Ops ----
SENTRY_DSN=
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# ---- Shopify App Pricing (Partner API, API version remains 2026-07) ----
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_APP_HANDLE=booknest
SHOPIFY_PLAN_FREE_HANDLE=free
SHOPIFY_PLAN_STANDARD_HANDLE=standard
SHOPIFY_PLAN_PRO_HANDLE=pro
SHOPIFY_PLAN_PRO_PLUS_HANDLE=pro-plus
# Enable only after configuring and testing the hosted plans.
BILLING_ENFORCEMENT=false
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Activate only after validating an $8 fixed-price monthly seat meter in Shopify.
TEAM_SEAT_BILLING_ENABLED=false
SHOPIFY_TEAM_SEAT_METER_HANDLE=team-seat-month

# Direct deployment to the existing isolated BookNest Coolify resources.
# These variables stay local; they are never sent to the app container.
COOLIFY_API_URL=https://coolify.solnix.store
COOLIFY_API_TOKEN=
COOLIFY_PROJECT_UUID=ylmkxwkdipsdsejunt4amhhn
COOLIFY_ENVIRONMENT_UUID=fihtdndt6lv0jejbxsmfskto
COOLIFY_SERVER_UUID=myfwitwdjhljv0ksumbn9vqq
COOLIFY_DATABASE_UUID=b73qjlnjubl0iyyiyzo3atxt
