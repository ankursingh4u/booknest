# ---- Shopify ----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://booknest.fly.dev
SCOPES=read_products,write_products,read_orders,write_orders,read_draft_orders,write_draft_orders,read_customers,write_customers,read_locations

# ---- Database (Neon) ----
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/booknest?sslmode=require
DIRECT_URL=postgresql://user:pass@ep-xxx.neon.tech/booknest?sslmode=require

# ---- Email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="BookNest <bookings@yourdomain.com>"

# ---- Google Calendar ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://booknest.fly.dev/auth/google/callback

# ---- AI insights ----
ANTHROPIC_API_KEY=

# ---- Ops ----
SENTRY_DSN=
SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
